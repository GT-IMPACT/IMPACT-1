impact.462.name=IV Assembling Machine
impact.462.desc=Сборщик IV уровня.

#QUEST #463 - Iridium Ingot
impact.463.name=Iridium Ingot
impact.463.desc=Иридий.

#QUEST #464 - HPIC Wafer
impact.464.name=HPIC Wafer
impact.464.desc=Пластина, из которой нарезаются компоненты для высокотехнологичных устройств.

#QUEST #465 - Tiny Niobium-Titanium Pipe
impact.465.name=Tiny Niobium-Titanium Pipe
